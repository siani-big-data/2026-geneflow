# =============================================================================
# GeneFlow production environment (lives at /opt/geneflow/.env on the host)
# =============================================================================
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.prod.example .env
# Generate secrets:
#   openssl rand -base64 64   # JWT_SECRET_KEY
#   openssl rand -base64 32   # TWOFACTOR_ENCRYPTION_KEY / WORKER_API_KEY
# =============================================================================

# --- Image tags (which tag each service pulls; CD publishes :latest) ---------
BACKEND_TAG=latest
FRONTEND_TAG=latest
AI_TAG=latest
ANALYSIS_TAG=latest
DATALAKE_TAG=latest

# --- Domains / TLS -----------------------------------------------------------
ADMIN_EMAIL=admin@geneflow.app
API_DOMAIN=api.geneflow.app
FRONTEND_DOMAIN=app.geneflow.app
# Used by the API for CORS + email links:
FRONTEND_URL=https://app.geneflow.app

# --- Database ----------------------------------------------------------------
POSTGRES_USER=geneflow
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=geneflow_db

# --- Backend security --------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_base64_64
TWOFACTOR_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
WORKER_API_KEY=CHANGE_ME_shared_secret_api_and_worker

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=noreply@geneflow.app

# --- OAuth -------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=

# --- AI service --------------------------------------------------------------
AI_API_KEY=
AI_LLM_PROVIDER=deepseek
AI_DEEPSEEK_API_KEY=
AI_CLAUDE_API_KEY=
NCBI_EMAIL=
NCBI_API_KEY_1=

# --- Datalake ----------------------------------------------------------------
DATALAKE_API_KEY=
