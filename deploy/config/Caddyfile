# =============================================================================
# GeneFlow Caddy Configuration
# =============================================================================
# Caddy automatically obtains and renews SSL certificates from Let's Encrypt
#
# Usage:
#   1. Replace YOUR_EMAIL with your email for Let's Encrypt
#   2. Replace YOUR_DOMAIN with your actual domain
#   3. Ensure DNS points to this server
# =============================================================================

{
    # Email for Let's Encrypt notifications
    email {$ADMIN_EMAIL:admin@geneflow.app}

    # Staging CA for testing (uncomment to avoid rate limits during testing)
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# =============================================================================
# API Backend
# =============================================================================
{$API_DOMAIN:api.geneflow.app} {
    reverse_proxy api:5145

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Remove server identification
        -Server
    }

    # Enable compression
    encode gzip zstd

    # Logging
    log {
        output file /data/logs/api-access.log {
            roll_size 100mb
            roll_keep 10
        }
        format json
    }

    # Handle large file uploads (traces up to 15MB)
    request_body {
        max_size 15MB
    }

    # Rate limiting (optional - uncomment to enable)
    # rate_limit {
    #     zone api {
    #         key {remote_host}
    #         events 100
    #         window 1m
    #     }
    # }
}

