{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=geneflow;Username=geneflow;Password=geneflow;Timeout=60;Command Timeout=120"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "GeneFlow.Api",
    "Audience": "GeneFlow.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379",
    "SequenceKeyPrefix": "geneflow:seq:",
    "EventStreamPrefix": "geneflow:events:",
    "JobStreamPrefix": "geneflow:jobs:",
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 5000
  },
  "Worker": {
    "ApiKey": "geneflow-worker-api-key-change-in-production"
  },
  "Email": {
    "SmtpHost": "smtp.resend.com",
    "SmtpPort": 587,
    "SmtpUsername": "resend",
    "SmtpPassword": "REDACTED",
    "FromEmail": "onboarding@resend.dev",
    "FromName": "GeneFlow",
    "UseSsl": true,
    "BaseUrl": "http://localhost:3000"
  },
  "TwoFactor": {
    "Issuer": "GeneFlow",
    "EncryptionKey": "YourSecure32CharEncryptionKeyHere!"
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15
  },
  "Storage": {
    "BasePath": "./uploads"
  },
  "DatalakeStorage": {
    "EndpointUrl": "http://localhost:9000",
    "AccessKey": "geneflow",
    "SecretKey": "geneflow123",
    "Bucket": "geneflow",
    "UseSSL": false,
    "TimeoutSeconds": 30
  },
  "OAuth": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "GitHub": {
      "ClientId": "YOUR_GITHUB_CLIENT_ID",
      "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET"
    }
  },
  "Stripe": {
    "SecretKey": "REDACTED_STRIPE_SECRET_KEY"
  }
}
