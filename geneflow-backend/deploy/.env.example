# =============================================================================
# GeneFlow Environment Variables
# =============================================================================
# Copy this file to .env and configure the values.
# NEVER commit .env to version control!
#
# Generate secrets with:
#   openssl rand -base64 64  # For JWT_SECRET_KEY
#   openssl rand -base64 32  # For TWOFACTOR_ENCRYPTION_KEY
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=geneflow
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=geneflow_db

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# JWT secret key (64 bytes base64)
JWT_SECRET_KEY=CHANGE_THIS_GENERATE_WITH_openssl_rand_base64_64

# Two-factor encryption key (32 bytes base64)
TWOFACTOR_ENCRYPTION_KEY=CHANGE_THIS_GENERATE_WITH_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# URLS
# -----------------------------------------------------------------------------
# API domain (must match DNS and Caddyfile)
BASE_URL=https://api.geneflow.app

# Frontend domain (for CORS configuration)
FRONTEND_URL=https://app.geneflow.app

# -----------------------------------------------------------------------------
# EMAIL (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@geneflow.app

# -----------------------------------------------------------------------------
# DOCKER REGISTRY (Optional - for CI/CD)
# -----------------------------------------------------------------------------
# DOCKER_REGISTRY=ghcr.io
# IMAGE_NAME=your-org/geneflow-api
# IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# CADDY (Optional)
# -----------------------------------------------------------------------------
# ADMIN_EMAIL=admin@geneflow.app
# API_DOMAIN=api.geneflow.app
