# Redis
AI_REDIS_URL=redis://localhost:6379
AI_REDIS_CONSUMER_GROUP=ai-consumers
AI_REDIS_CONSUMER_NAME=ai-1

# API
AI_API_HOST=0.0.0.0
AI_API_PORT=8090
AI_API_KEY=

# CORS
AI_CORS_ORIGINS=["*"]

# LLM Provider: "claude", "deepseek", or "auto" (cheapest available)
AI_LLM_PROVIDER=deepseek

# DeepSeek API (cheap: ~$0.07/100K tokens)
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-chat

# Claude API (higher quality, higher cost)
AI_CLAUDE_API_KEY=
AI_CLAUDE_MODEL=claude-sonnet-4-20250514

# NCBI BLAST
AI_BLAST_EMAIL=
AI_BLAST_API_KEY=

# Event Bus
AI_EVENTBUS_ENABLED=true
AI_EVENTBUS_STREAM_PREFIX=geneflow:events
AI_SUBSCRIBED_CATEGORIES=["traces","alignments"]

# Logging
AI_LOG_LEVEL=INFO
